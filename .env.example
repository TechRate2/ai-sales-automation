NODE_ENV=development
LOG_LEVEL=info
APP_PORT=3000

BOTCAKE_API_BASE_URL=https://botcake.io/api/public_api/v1
# Có thể để trống nếu BOTCAKE_API_TOKEN là page token dạng JWT có field id.
# Nên nhập thủ công trong production nếu muốn khóa cứng page/bot đang vận hành.
BOTCAKE_PAGE_ID=
BOTCAKE_API_TOKEN=
BOTCAKE_WEBHOOK_SECRET=
BOTCAKE_DEFAULT_TIMEOUT_MS=8000
BOTCAKE_RETRY_MAX_ATTEMPTS=3
BOTCAKE_RETRY_BASE_DELAY_MS=300

PANCAKE_POS_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_POS_API_KEY=
# Có thể lấy tự động bằng GET /shops sau khi có PANCAKE_POS_API_KEY.
PANCAKE_POS_SHOP_ID=
# Có thể lấy bằng GET /shops/{PANCAKE_POS_SHOP_ID}/warehouses.
PANCAKE_POS_DEFAULT_WAREHOUSE_ID=
PANCAKE_POS_TIMEOUT_MS=10000
PANCAKE_POS_RETRY_MAX_ATTEMPTS=3
PANCAKE_POS_RETRY_BASE_DELAY_MS=500

ENABLE_POS_DRAFT_ORDER=false
PANCAKE_POS_SAFE_DRAFT_STATUSES=
